AI_LEARNING_DATABASE_URL=postgresql+psycopg://urpapa:postgres@host.docker.internal:5432/ai_learning
AI_LEARNING_LLM_BASE_URL=https://api.deepseek.com
AI_LEARNING_LLM_API_KEY=
AI_LEARNING_LLM_MODEL=deepseek-v4-flash
AI_LEARNING_UPLOAD_MAX_BYTES=5242880

# Embedding 配置
AI_LEARNING_EMBEDDING_PROVIDER=openai_compatible
AI_LEARNING_EMBEDDING_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_LEARNING_EMBEDDING_API_KEY=
AI_LEARNING_EMBEDDING_MODEL=text-embedding-v3
AI_LEARNING_EMBEDDING_DIMENSIONS=1024

# 检索配置
AI_LEARNING_RETRIEVAL_MIN_SCORE=0.35
AI_LEARNING_RETRIEVAL_TOP_K=5
AI_LEARNING_RETRIEVAL_CANDIDATE_K=20

# 日志配置
AI_LEARNING_SQL_ECHO=false
AI_LEARNING_RAG_DEBUG_LOGS=false

# 认证配置
# 必填：至少 32 字符的强随机密钥，用于签发 JWT 会话令牌
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_LEARNING_AUTH_SECRET=
# JWT 有效期（秒），默认 28800 (8 小时)
AI_LEARNING_AUTH_TOKEN_TTL_SECONDS=28800
# Cookie Secure 属性：本地 HTTP 开发用 false，公网 HTTPS 部署必须设为 true
AI_LEARNING_AUTH_COOKIE_SECURE=false
