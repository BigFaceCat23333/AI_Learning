# 数据库连接
AI_LEARNING_DATABASE_URL=postgresql+psycopg://urpapa:postgres@localhost:5432/ai_learning

# LLM 配置
AI_LEARNING_LLM_BASE_URL=https://api.openai.com/v1
AI_LEARNING_LLM_API_KEY=
AI_LEARNING_LLM_MODEL=gpt-4.1-mini

# Embedding 配置
AI_LEARNING_EMBEDDING_PROVIDER=openai_compatible
AI_LEARNING_EMBEDDING_BASE_URL=
AI_LEARNING_EMBEDDING_API_KEY=
AI_LEARNING_EMBEDDING_MODEL=text-embedding-v4
AI_LEARNING_EMBEDDING_DIMENSIONS=1536

# 检索配置
AI_LEARNING_RETRIEVAL_MIN_SCORE=0.35
AI_LEARNING_RETRIEVAL_TOP_K=5
AI_LEARNING_RETRIEVAL_CANDIDATE_K=20

# 日志配置
AI_LEARNING_SQL_ECHO=false
AI_LEARNING_RAG_DEBUG_LOGS=false

# 认证配置
# 必填：至少 32 字符的随机密钥，用于签发 JWT 会话令牌
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_LEARNING_AUTH_SECRET=
# JWT 有效期（秒），默认 28800 (8 小时)
AI_LEARNING_AUTH_TOKEN_TTL_SECONDS=28800
# Cookie Secure 属性：本地 HTTP 用 false，公网 HTTPS 必须设为 true
AI_LEARNING_AUTH_COOKIE_SECURE=false
